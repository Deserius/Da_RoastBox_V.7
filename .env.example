# ==============================================================================
# Da RoastBox V.7 — Complete Master Environment Template (.env.example)
# ==============================================================================
# IMPORTANT:
#   - Never commit real secrets! Copy backend values into `backend/.env` and
#     frontend values into `frontend/.env` (or use the Setup Vault on port 8090:
#     `scripts/key_setup_server.py`).
#   - `backend/.env.example`   -> Backend-only template
#   - `frontend/.env.example`  -> Frontend-only template
#   - `deploy/render.env.example` -> Render + Vercel deployment template
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. DATABASE & CORE SECURITY (backend/.env)
# ------------------------------------------------------------------------------
# Local sandbox: mongodb://127.0.0.1:27017
# Production (MongoDB Atlas): mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=da_roastbox

# Signs session JWTs AND derives the Fernet key encrypting user BYOK API keys.
# Generate a 64-char hex secret once and NEVER change it on an existing DB.
JWT_SECRET=

# Comma-separated browser origins allowed to send credentials to FastAPI.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Comma-separated Host headers in beta/production (e.g. api.daroastbox.com).
ALLOWED_HOSTS=
# Public frontend URL used for Stripe returns, email links, and beta cookies.
APP_BASE_URL=
# development | beta | production
APP_ENV=development


# ------------------------------------------------------------------------------
# 2. AI WRITERS, VISION & VOICE SYNTHESIS (backend/.env)
# ------------------------------------------------------------------------------
# Primary multimodal writer + vision router (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Direct OpenAI key for gpt-4o-mini-tts speech + backup vision/writer (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Expressive comedian TTS voices (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=
# Optional Emergent Universal LLM proxy key (https://app.emergent.sh)
EMERGENT_LLM_KEY=

# Provider routing & model chain
AI_DEFAULT_PROVIDER=openai
ROAST_WRITER_PROVIDER=openrouter
ROAST_WRITER_PROFILE=multimodal
ROAST_OPENROUTER_MODELS=anthropic/claude-sonnet-4.5,openai/gpt-4.1,openai/gpt-4o
ROAST_BACKUP_PROVIDERS=emergent,openai
ROAST_SPEED_PROFILE=balanced
ROAST_WRITER_DEADLINE_S=75
ROAST_MAX_INPUT_USD_PER_M=3.00
ROAST_MAX_OUTPUT_USD_PER_M=15.00
ROAST_PAID_PRIMARY_MODEL=thedrummer/cydonia-24b-v4.1
ROAST_PAID_STANDARD_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition
ROAST_PAID_BACKUP_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition
ROAST_WRITER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
ROAST_FREE_PREMIUM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
ROAST_FREE_BACKUP_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
ROAST_OPENROUTER_PROVIDER_ONLY=
ROAST_OPENROUTER_ALLOW_FALLBACKS=false
ROAST_FREE_WRITER_ONLY=false
ROAST_POLLINATIONS_FALLBACK=false
ROAST_ALLOW_PAID_WRITER_FALLBACK=true
TTS_MODEL=gpt-4o-mini-tts
VOICE_LEVELING_ENABLED=true
VOICE_TARGET_RMS_DBFS=-19


# ------------------------------------------------------------------------------
# 3. STRIPE PAYMENTS & WEBHOOKS (backend/.env)
# ------------------------------------------------------------------------------
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=
STRIPE_PUBLISHABLE_KEY=
# Get signing secret at https://dashboard.stripe.com/webhooks (or `stripe listen`)
STRIPE_WEBHOOK_SECRET=
# Keep true for staging/testing (rejects sk_live_ keys); set false only for live launch.
STRIPE_TEST_ONLY=true


# ------------------------------------------------------------------------------
# 4. GOOGLE LOGIN & AUTHENTICATION (backend/.env)
# ------------------------------------------------------------------------------
# Direct Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
# Leave blank to use Emergent Managed Google Auth instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact Authorized Redirect URI (e.g. https://yourdomain.com/auth-complete.html)
GOOGLE_REDIRECT_URI=
# Managed Emergent integration proxy URL
INTEGRATION_PROXY_URL=https://integrations.emergentagent.com

# Preview & Dev Guardrails (MUST be false in production!)
ENABLE_PREVIEW_LOGIN=false
ALLOW_PREVIEW_HOSTED_AI=false
PREVIEW_UNLIMITED_CREDITS=false
PREVIEW_HOSTED_DAILY_SHOW_LIMIT=5
PREVIEW_HOSTED_DAILY_VOICE_LIMIT=10
ALLOW_DEV_LOGIN=false
ALLOW_SOURCE_DOWNLOAD=false


# ------------------------------------------------------------------------------
# 5. OPTIONAL EMAIL / PASSWORD AUTH (backend/.env)
# ------------------------------------------------------------------------------
EMAIL_AUTH_ENABLED=false
# smtp | resend
EMAIL_TRANSPORT=smtp
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) | ssl (port 465)
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=


# ------------------------------------------------------------------------------
# 6. MEDIA STORAGE, REELS & BETA ACCESS GATE (backend/.env)
# ------------------------------------------------------------------------------
# emergent | local | vercel_blob
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=
AUDIO_CACHE_DIR=
PERSISTENT_STORAGE_CONFIRMED=false
DATA_IMPORT_CONFIRMED=false
BLOB_READ_WRITE_TOKEN=
REEL_ENCODER_PRESET=ultrafast

# Diagnostics (keep false unless debugging with explicit admin user IDs)
ENABLE_PAID_DIAGNOSTICS=false
DIAGNOSTICS_ADMIN_USER_IDS=

# Site-wide Beta Gate (active only when APP_ENV=beta)
# Generate scrypt verifier via Setup Vault (:8090) or `scripts/create_beta_gate.py`
BETA_ACCESS_PASSWORD_HASH=
BETA_ACCESS_SIGNING_KEY=


# ------------------------------------------------------------------------------
# 7. CLOUD LAUNCH CONNECTORS — SUPABASE & VERCEL (backend/.env)
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VERCEL_TOKEN=


# ------------------------------------------------------------------------------
# 8. FRONTEND PUBLIC SETTINGS (frontend/.env)
# ------------------------------------------------------------------------------
# WARNING: Never place secret keys in REACT_APP_* variables (they ship to browsers).
HOST=0.0.0.0
PORT=3000
# Empty = same-origin /api via proxy (recommended). Or set deployed API origin.
REACT_APP_BACKEND_URL=
API_PROXY_TARGET=http://127.0.0.1:8001
REACT_APP_ENABLE_PREVIEW_LOGIN=false
REACT_APP_SOURCE_DOWNLOAD_ENABLED=false
REACT_APP_ENABLE_SESSION_TUNNEL=false
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_SUPABASE_ANON_KEY=
REACT_APP_SUPPORT_EMAIL=
REACT_APP_INSTAGRAM_URL=
REACT_APP_FACEBOOK_URL=
REACT_APP_TIKTOK_URL=
REACT_APP_YOUTUBE_URL=
